# ==============================================================================
# OutOfBlack // Tactical Backend Environment Configuration
# ==============================================================================

# CARTO.com API Key / Access Token
# Wklej tutaj swój klucz API wygenerowany w panelu CARTO (np. Developer -> API Keys):
CARTO_API_KEY=

# (Opcjonalnie) Własny szablon URL kafelków CARTO / Mapbox / Stadia Maps:
# Domyślnie używany jest styl Carto Dark Matter:
# https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
CARTO_TILE_URL=

# (Opcjonalnie) Klucz Mapbox Access Token (jeśli frontend korzysta z Mapbox GL / mapbox-dark):
MAPBOX_API_KEY=

# Konfiguracja sieciowa serwera
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Dozwolone originy CORS (oddzielone przecinkami)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# (Opcjonalnie) Token uwierzytelniania strumienia WebSocket (pozostaw puste dla trybu lokalnego bez auth):
WS_AUTH_TOKEN=

# (Opcjonalnie) Sól kryptograficzna do anonimizacji adresów MAC ofiar (pozostaw puste dla losowej per-sesja):
MAC_HASH_SALT=
